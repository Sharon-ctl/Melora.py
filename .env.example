# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
OWNER_ID=123456789012345678

# Lavalink Node Configuration
# Option 1: Multi-node configuration via JSON list (Recommended for production/failover)
# LAVALINK_NODES=[{"name":"main","host":"127.0.0.1","port":2333,"password":"change-me","region":"us","secure":false},{"name":"backup","host":"127.0.0.2","port":2333,"password":"change-me","region":"us","secure":false}]

# Option 2: Single node configuration (used if LAVALINK_NODES is unset)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me
LAVALINK_REGION=us
LAVALINK_SSL=false
LAVALINK_NAME=main
LAVALINK_EXTRA_NODES=

# Search and Playback
DEFAULT_SEARCH_SOURCE=ytmsearch
FALLBACK_SEARCH_SOURCE=scsearch
DEFAULT_VOLUME=100
# User-Facing Limits: Default 0 = UNLIMITED (no artificial limits)
MAX_TRACK_SECONDS=0
MAX_QUEUE_SIZE=0
MAX_PER_USER=0
MAX_PLAYLIST_TRACKS=0
FAILURE_BREAKER=3
PLAY_COOLDOWN=0.0
AUTOCOMPLETE_SEARCH_ENABLED=true

# Spotify Configuration (Scraper-based, no Spotify API keys required)
SPOTIFY_ENABLED=true

# Vote Skip Configuration
VOTE_SKIP_ENABLED=true
VOTE_SKIP_MIN_LISTENERS=3

# Autoplay and History
HISTORY_SIZE=50
AUTOPLAY_BATCH_SIZE=5
USER_HISTORY_ENABLED=true
USER_HISTORY_MAX=50

# Library Limits: Default 0 = UNLIMITED
MAX_FAVORITES_PER_USER=0
MAX_PLAYLISTS_PER_USER=0
MAX_TRACKS_PER_PLAYLIST=0

# Timeouts & Sweeps (in seconds)
IDLE_TIMEOUT=300
ALONE_TIMEOUT=60
LOAD_TIMEOUT=15.0
WATCHDOG_INTERVAL=60
HEARTBEAT_INTERVAL=300
NODE_LOSS_GRACE=30

# Gateway, Intents & Mention Reply
# When MENTION_REPLY_ENABLED=false, guild_messages intent and on_message dispatch are dropped completely for scale
MENTION_REPLY_ENABLED=true
MENTION_REPLY_COOLDOWN=10.0

# Voice Channel Status
VOICE_STATUS_ENABLED=true
VOICE_STATUS_USE_EMOJI=true

# Rate Limiting & Cooldowns
# Rate limits are configured in data/rate_limits.json (all default limits removed / disabled by default)

# Database and Backup
DB_PATH=data/bot.db
BACKUP_COUNT=7

# Permissions & Concurrency
DJ_ROLE_ID=0
SYNC_ON_START=true
MAX_CONCURRENT_LOADS=64
PER_GUILD_CONCURRENT_LOADS=4
LOG_LEVEL=INFO
LOG_DIR=logs
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL=600
