# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
OWNER_ID=123456789012345678

# Lavalink Node Configuration
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=123
LAVALINK_REGION=us
LAVALINK_SSL=false
LAVALINK_NAME=main
LAVALINK_EXTRA_NODES=

# Search and Playback
DEFAULT_SEARCH_SOURCE=ytmsearch
FALLBACK_SEARCH_SOURCE=scsearch
DEFAULT_VOLUME=100
MAX_TRACK_SECONDS=3600
MAX_QUEUE_SIZE=200
MAX_PER_USER=50
FAILURE_BREAKER=3
PLAY_COOLDOWN=5.0
AUTOCOMPLETE_SEARCH_ENABLED=true

# Spotify Configuration (No API keys needed, scraper-based)
SPOTIFY_ENABLED=true

# Vote Skip Configuration
VOTE_SKIP_ENABLED=true
VOTE_SKIP_MIN_LISTENERS=3

# Autoplay and History
HISTORY_SIZE=50
AUTOPLAY_BATCH_SIZE=5

# Library Limits
MAX_FAVORITES_PER_USER=50
MAX_PLAYLISTS_PER_USER=20
MAX_TRACKS_PER_PLAYLIST=100

# Timeouts (in seconds)
IDLE_TIMEOUT=300
ALONE_TIMEOUT=60
LOAD_TIMEOUT=15.0
WATCHDOG_INTERVAL=60
HEARTBEAT_INTERVAL=300
NODE_LOSS_GRACE=30
# Rate Limiting & Cooldowns
# Sliding-window rate limit definitions are configured in data/rate_limits.json
MENTION_REPLY_COOLDOWN=10.0

# Database and Backup
DB_PATH=data/bot.db
BACKUP_COUNT=7

# Permissions & Operational
DJ_ROLE_ID=0
SYNC_ON_START=true
MAX_CONCURRENT_LOADS=4
LOG_LEVEL=INFO
LOG_DIR=logs
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL=600
